```bash
sudo cryptsetup luksFormat /dev/sda1

mkdir /media/whk/Personal/disks/WBMyBook6T_01
dd if=/dev/urandom of=/media/whk/Personal/disks/WBMyBook6T_01/keyfile bs=1024 count=8
sudo cryptsetup luksAddKey --key-slot 1 /dev/sda1 /media/whk/Personal/disks/WBMyBook6T_01/keyfile
sudo cryptsetup luksHeaderBackup /dev/sda1 --header-backup-file /media/whk/Personal/disks/WBMyBook6T_01/luks-header.backup
```

```bash
sudo cryptsetup luksOpen /dev/sda1 WBMyBook6T_01
sudo mkfs.ext4 -t ext4 -L WBMYBook6T_01 -U time /dev/mapper/WBMyBook6T_01
```

